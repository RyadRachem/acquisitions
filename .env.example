# ==============================================================================
# Acquisitions Application - Environment Variables Template
# ==============================================================================

# Server
PORT=3000
NODE_ENV=development # 'development' | 'production' | 'test'
LOG_LEVEL=info # 'debug' | 'info' | 'warn' | 'error'

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Local Development (via Neon Local Docker Compose):
# DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb
# NEON_FETCH_ENDPOINT=http://neon-local:5432/sql

# For Production (direct Neon Cloud Postgres):
# DATABASE_URL=postgresql://user:password@ep-name.region.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb

# ------------------------------------------------------------------------------
# 2. NEON LOCAL CONFIGURATION (Development only)
# ------------------------------------------------------------------------------
# API Key from: https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=
# Project ID from: Neon Console -> Project Settings -> General
NEON_PROJECT_ID=
# Ephemeral branch parent (leave empty to use default branch):
# PARENT_BRANCH_ID=br-main-branch-id
# Delete ephemeral branch when container stops (default: true):
DELETE_BRANCH=true

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTH
# ------------------------------------------------------------------------------
ARCJET_ENV=development
ARCJET_KEY=
JWT_SECRET=your_jwt_secret_here